# SocialPlatform Development Environment

# JWT
JWT_SECRET=dev_secret_change_in_production_abc123

# Gateway
GATEWAY_PORT=8000
AUTH_SERVICE_URL=http://auth-service:8001
USERS_SERVICE_URL=http://users-service:8002
POSTS_SERVICE_URL=http://posts-service:8003
MESSAGES_SERVICE_URL=http://messages-service:8004
MINIO_URL=http://minio:9000
FRONTEND_URL=http://frontend:3000

# Auth Service
AUTH_DB_URL=postgresql://user:password@db:5432/auth_db
AUTH_SERVICE_PORT=8001

# Users Service
USERS_DB_URL=postgresql://user:password@db:5432/social_db
USERS_SERVICE_PORT=8002
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=miniopassword123
MINIO_BUCKET_AVATARS=avatars

# Posts Service
POSTS_DB_URL=postgresql://user:password@db:5432/social_db
POSTS_SERVICE_PORT=8003
MINIO_BUCKET_POSTS=post-images

# Messages Service
MESSAGES_DB_URL=postgresql://user:password@db:5432/social_db
MESSAGES_SERVICE_PORT=8004

# Frontend (empty = relative URLs, since gateway serves everything)
VITE_API_BASE_URL=

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword123

# Postgres
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=postgres
